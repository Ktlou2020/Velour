# Database (add yours from Railway PostgreSQL service)
DATABASE_URL="postgresql://user:password@host:5432/hush_db"

# NextAuth (generate secret: openssl rand -base64 32)
NEXTAUTH_URL="https://your-railway-domain.railway.app"
NEXTAUTH_SECRET="your-generated-secret"

# Google OAuth (optional - get from console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="https://your-railway-domain.railway.app"

# Cron jobs — bearer token for /api/cron/* (generate: openssl rand -hex 32).
# Required for event RSVP reminders; the cron endpoints refuse all requests when unset.
CRON_SECRET=""

# Security
# Comma-separated emails granted ADMIN on each deploy (scripts/seed-admin.mjs).
ADMIN_EMAILS=""
# Seconds between session re-validation against the DB (role / ban / password). Default 300.
AUTH_REFRESH_SECONDS="300"

# Media storage — uploaded photos, chat images and profile videos are stored on
# disk and served through /api/media/<id> with access checks. In production mount
# a Railway volume (e.g. at /data) and point this at a folder on it. Defaults to
# ./.uploads (relative to the server's working directory) when unset.
UPLOAD_DIR="/data/uploads"

# Legacy (optional): only needed so older Cloudinary photo/video URLs keep validating.
CLOUDINARY_CLOUD_NAME=""
