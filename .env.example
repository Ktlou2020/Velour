# Database (add yours from Railway PostgreSQL service)
DATABASE_URL="postgresql://user:password@host:5432/hush_db"

# NextAuth (generate secret: openssl rand -base64 32)
NEXTAUTH_URL="https://your-railway-domain.railway.app"
NEXTAUTH_SECRET="your-generated-secret"

# Google OAuth (optional - get from console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="https://your-railway-domain.railway.app"

# Cron jobs — bearer token for /api/cron/* (generate: openssl rand -hex 32).
# Required for event RSVP reminders; the cron endpoints refuse all requests when unset.
# Membership lifecycle: call /api/cron/subscriptions hourly (expiry after a 3-day grace,
# renewal reminders, past-due reminders) with  Authorization: Bearer $CRON_SECRET.
CRON_SECRET=""

# Security
# Comma-separated emails granted ADMIN on each deploy (scripts/seed-admin.mjs).
ADMIN_EMAILS=""
# Seconds between session re-validation against the DB (role / ban / password). Default 300.
AUTH_REFRESH_SECONDS="300"

# Media storage — uploaded photos, chat images and profile videos are stored on
# disk and served through /api/media/<id> with access checks. In production mount
# a Railway volume (e.g. at /data) and point this at a folder on it. Defaults to
# ./.uploads (relative to the server's working directory) when unset.
UPLOAD_DIR="/data/uploads"

# Media in an S3-compatible bucket (Railway Buckets, Cloudflare R2, AWS S3, MinIO).
# Set S3_BUCKET to switch on: new uploads go to the bucket, reads try the bucket
# first and fall back to UPLOAD_DIR (files not migrated yet), deletes hit both.
# Unset = local disk only, exactly as before. Copy existing files across with
#   node scripts/migrate-media-to-s3.mjs   (see README "Media storage (S3 / Railway Buckets / R2)")
# Railway: reference the bucket's Credentials, e.g. S3_BUCKET="${{media.BUCKET}}".
# S3_BUCKET=""
# S3_ENDPOINT=""                # https://t3.storageapi.dev (Railway) · https://<account>.r2.cloudflarestorage.com (R2)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"              # default "auto" (Railway, R2); AWS: e.g. "af-south-1"
# S3_FORCE_PATH_STYLE="false"   # "true" = endpoint/bucket/key (MinIO, most local mocks); default virtual-hosted bucket.endpoint/key
# S3_TIMEOUT_MS="20000"         # per request, until response headers

# Legacy (optional): only needed so older Cloudinary photo/video URLs keep validating.
CLOUDINARY_CLOUD_NAME=""

# Web push (optional). Generate with: npx web-push generate-vapid-keys
# Unset = push is a silent no-op and the "Enable notifications" prompt is hidden.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:hello@unboundza.com"

# Payments — Paystack (primary). When PAYSTACK_SECRET_KEY is set, membership upgrades and
# the store use Paystack; otherwise PayFast below (if configured) is used.
# Keys: Paystack dashboard → Settings → API Keys & Webhooks (sk_test_… for test mode).
# Webhook URL (same page): https://www.unboundza.com/api/payment/paystack/webhook
# Webhooks are signed with the secret key — there is no separate webhook secret.
PAYSTACK_SECRET_KEY=""
# Optional; not needed for the redirect checkout.
PAYSTACK_PUBLIC_KEY=""
# Optional plan codes (PLN_…) from Paystack → Products → Plans. Amounts must match
# MEMBERSHIP_PRICES in lib/payfast.ts (ZAR, monthly / annually). When unset, a plan named
# e.g. "Unbound Gold (Monthly)" is found or created automatically (its code is logged — pin it here).
PAYSTACK_PLAN_GOLD_MONTHLY=""
PAYSTACK_PLAN_GOLD_ANNUAL=""
PAYSTACK_PLAN_PLATINUM_MONTHLY=""
PAYSTACK_PLAN_PLATINUM_ANNUAL=""
# Optional: where billing problems needing a human go (failed provider cancels, refunds to make).
# Defaults to STORE_ADMIN_EMAIL, then support@unboundza.com.
BILLING_ALERT_EMAIL=""

# Payments — PayFast (fallback: membership upgrades and the store). Unset merchant id/key =
# checkout returns "Payments aren't set up yet" (the store stays browsable).
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
# Set the same passphrase in PayFast → Settings → Developer settings (required for subscriptions).
PAYFAST_PASSPHRASE=""
# "true" = sandbox.payfast.co.za (test credentials: 10000100 / 46f0cd694581a / jt7NOE43FZPn)
PAYFAST_SANDBOX="false"
# Local testing ONLY: skip the server-to-server ITN check (ignored for live payments in production).
# PAYFAST_SKIP_VALIDATE="true"

# Store (Toystory). The store name itself lives in lib/store/config.ts (STORE_NAME).
# Flat delivery fee and free-delivery threshold in cents (defaults R 99 and R 1 000; 0 = never free).
STORE_SHIPPING_CENTS="9900"
STORE_FREE_SHIPPING_OVER_CENTS="100000"
# Sender name printed on discreet parcels.
STORE_DISCREET_SENDER="HS Trading"
# Optional: also email new paid orders and payment problems here.
STORE_ADMIN_EMAIL=""

# Email delivery: Brevo API (preferred). Sender must be a verified Brevo sender/domain.
BREVO_API_KEY=""
EMAIL_FROM="Unbound <noreply@unboundza.com>"
# Or SMTP instead of Brevo:
# EMAIL_HOST="" EMAIL_PORT="587" EMAIL_USER="" EMAIL_PASS=""

# Database migrations (scripts/migrate.mjs, run on every start). Emergency only, for ONE
# deploy: baseline a db-push database that doesn't match prisma/migrations/0_init. See README.
# MIGRATE_BASELINE_ALLOW_DRIFT="1"

# Error monitoring — Sentry (optional; unset = Sentry is not loaded at all). See README.
# SENTRY_DSN=""                          # server/edge, runtime
# NEXT_PUBLIC_SENTRY_DSN=""              # browser, inlined at BUILD time (redeploy after changing)
# SENTRY_TRACES_SAMPLE_RATE="0.1"        # 0–1, server
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# SENTRY_ENVIRONMENT="production"        # default NODE_ENV (browser: NEXT_PUBLIC_SENTRY_ENVIRONMENT)
# Source-map upload at build time — skipped silently unless all three are set:
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Cron runner service (scripts/cron.mjs — a separate Railway cron service, */15 * * * *).
# Needs CRON_SECRET (above) and the web service's URL:
# CRON_TARGET_URL="https://www.unboundza.com"   # falls back to NEXT_PUBLIC_APP_URL
# CRON_INTERVAL_MINUTES="15"                    # = the schedule; hourly jobs run once per hour
# CRON_JOBS=""                                  # optional subset, e.g. "store,view-once"
# CRON_FORCE="1"                                # run hourly jobs regardless of the minute

# Database backups (ops/backup/backup.mjs — separate Railway cron service, root dir /ops/backup).
# Uses DATABASE_URL (or BACKUP_DATABASE_URL). Restore: scripts/restore.md.
# BACKUP_S3_ENDPOINT=""            # https://t3.storageapi.dev (Railway) · https://<account>.r2.cloudflarestorage.com (R2)
# BACKUP_S3_BUCKET=""
# BACKUP_S3_ACCESS_KEY_ID=""
# BACKUP_S3_SECRET_ACCESS_KEY=""
# BACKUP_S3_REGION="auto"
# BACKUP_S3_URL_STYLE="virtual"    # or "path" (MinIO)
# BACKUP_PREFIX="backups/"
# BACKUP_RETENTION_DAYS="30"       # 0 = keep forever
# BACKUP_MIN_KEEP="3"              # never prune below this many backups

# New members must click the link in their sign-up email before using the site.
# Turn on only once email delivery works (Brevo domain authenticated).
REQUIRE_EMAIL_VERIFICATION="false"
