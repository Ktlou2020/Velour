generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipTier {
  FREE
  GOLD
  PLATINUM
}

enum Gender {
  MAN
  WOMAN
  NON_BINARY
  OTHER
}

enum LikeType {
  LIKE
  SUPERLIKE
  WINK
  PASS
}

enum EventCategory {
  PARTY
  MEETUP
  WORKSHOP
  TRAVEL
  OTHER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  username     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  role         String   @default("USER")

  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  loginStreak         Int       @default(0)
  lastLoginDate       DateTime?
  superLikeCredits    Int       @default(1)
  verificationStatus  String    @default("NONE")
  verificationPhoto   String?
  completionMilestone Int       @default(0)

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  photos              Photo[]
  albums              Album[]
  sparkAnswers        SparkAnswer[]
  photoLikes          PhotoLike[]
  messageViews        MessageView[]
  orders              Order[]
  reviewsGiven        Review[]                  @relation("ReviewsGiven")
  reviewsReceived     Review[]                  @relation("ReviewsReceived")
  reviewRequestsSent  ReviewRequest[]           @relation("ReviewRequestsSent")
  reviewRequestsGot   ReviewRequest[]           @relation("ReviewRequestsGot")
  profileViewsGiven   ProfileView[]             @relation("ViewsGiven")
  profileViewsGot     ProfileView[]             @relation("ViewsGot")
  albumAccess         AlbumAccess[]
  likesGiven          Like[]                    @relation("LikesGiven")
  likesReceived       Like[]                    @relation("LikesReceived")
  matchesA            Match[]                   @relation("MatchUser1")
  matchesB            Match[]                   @relation("MatchUser2")
  messagesSent        Message[]
  conversations       ConversationParticipant[]
  events              EventAttendee[]
  forumPosts          ForumPost[]
  forumThreads        ForumThread[]
  notifications       Notification[]
  interests           UserInterest[]
  blocksGiven         Block[]                   @relation("BlocksGiven")
  blocksReceived      Block[]                   @relation("BlocksReceived")
  pushSubscriptions   PushSubscription[]
  datePlans           DatePlan[]
  verificationRequest VerificationRequest?
  subscriptions       Subscription[]
  payments            Payment[]
}

model Profile {
  id                  String         @id @default(cuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String?
  bio                 String?
  dateOfBirth         DateTime?
  gender              Gender?
  orientation         String?
  relationshipStatus  String?
  lookingFor          String[]       @default([])
  location            String?
  city                String?
  country             String?
  latitude            Float?
  longitude           Float?
  profilePhoto        String?
  isOnline            Boolean        @default(false)
  lastSeen            DateTime       @default(now())
  membershipTier      MembershipTier @default(FREE)
  profileCompleteness Int            @default(0)
  profileViews        Int            @default(0)
  allowMessages       Boolean        @default(true)
  privatePhotos       Boolean        @default(false)
  updatedAt           DateTime       @updatedAt

  partnerId String?  @unique
  partner   Profile? @relation("CoupleLink", fields: [partnerId], references: [id])
  partnerOf Profile? @relation("CoupleLink")
  isCouple  Boolean  @default(false)

  // Identity & inclusivity
  pronouns        String?
  // Optional self-described identity shown alongside gender, e.g. "Trans woman", "Genderqueer"
  genderLabel     String?
  // Who they want to meet: MAN, WOMAN, NON_BINARY, COUPLE
  interestedIn    String[] @default([])
  // What they're open to: e.g. DATING, RELATIONSHIP, FRIENDSHIP, CASUAL, COUPLES_PLAY, EVENTS
  intentions      String[] @default([])
  showGender      Boolean  @default(true)
  showOrientation Boolean  @default(true)
  // Couple profile details (when isCouple): e.g. "MF", "FF", "MM", "MX" — derived or chosen
  coupleType      String?

  // About me (all optional)
  heightCm      Int?
  bodyType      String?
  // Race/ethnicity is POPIA "special personal information": optional, self-described,
  // shown only when showEthnicity is true, and never used as a search filter.
  ethnicity     String?
  showEthnicity Boolean  @default(false)
  languages     String[] @default([])
  drinking      String?
  smoking       String?
  hasChildren   String?

  // Shared couple account: details for each person, e.g.
  // [{ name, gender, genderLabel, pronouns, dateOfBirth, orientation, heightCm, bodyType,
  //    ethnicity, showEthnicity, languages, drinking, smoking }]
  coupleMembers Json?

  // Status ("Free tonight 🍷"), shown until statusUntil
  statusText  String?
  statusEmoji String?
  statusUntil DateTime?

  // Travel mode (Gold+): appear in and browse another city until travelUntil
  travelCity    String?
  travelCountry String?
  travelLat     Float?
  travelLng     Float?
  travelUntil   DateTime?

  // Show my public photos in the Explore feed (opt-out)
  showInExplore Boolean @default(true)

  // Reviews (denormalised for ranking; recomputed when a review is published/hidden)
  ratingAvg   Float?
  ratingCount Int    @default(0)

  // Premium perks
  boostedUntil DateTime?
  lastBoostAt  DateTime?
  incognito    Boolean   @default(false)
  videoUrl     String?

  // Profile prompts: [{ question: string, answer: string }]
  prompts Json?

  // Safety & privacy
  isSnoozed      Boolean   @default(false)
  snoozedUntil   DateTime?
  showChatImages Boolean   @default(false)

  // First-run guided tour: set when the member finishes or skips it
  tourCompletedAt DateTime?
}

model Photo {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  isProfile    Boolean  @default(false)
  isPrivate    Boolean  @default(false)
  caption      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  // Self-hosted media (served via /api/media/[id] with access checks)
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
  albumId    String?
  album      Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  // Explore feed
  likeCount Int         @default(0)
  likes     PhotoLike[]
}

// A member's photo album. Private albums are visible only to the owner and
// to members with GRANTED access (via invite, or an approved request).
model Album {
  id           String        @id @default(cuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isPrivate    Boolean       @default(false)
  coverPhotoId String?
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  photos       Photo[]
  access       AlbumAccess[]
}

model AlbumAccess {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // INVITED (owner invited, awaiting acceptance), REQUESTED (member asked), GRANTED, DECLINED
  status    String   @default("INVITED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([albumId, userId])
}

model Like {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  type       LikeType @default(LIKE)
  createdAt  DateTime @default(now())
  fromUser   User     @relation("LikesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

model Match {
  id        String    @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  user1     User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}

model VerificationRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  photoUrl  String
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String                    @id @default(cuid())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessage   String?
  lastMessageAt DateTime?
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  unreadCount    Int          @default(0)
  typingUntil    DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id                String        @id @default(cuid())
  conversationId    String
  senderId          String
  content           String
  imageUrl          String?
  // For couples sharing one account: which partner wrote this (name from Profile.coupleMembers)
  senderPartnerName String?
  // TEXT | IMAGE | VOICE | GAME
  kind              String        @default("TEXT")
  audioUrl          String?
  audioDurationSec  Int?
  // Game payload for kind = GAME, e.g. { game: "this_or_that", prompt, options, answers }
  meta              Json?
  // Priority message (Gold+): pinned to the top of the recipient's inbox
  isPriority        Boolean       @default(false)
  // View-once media: each recipient may open it once; file deleted when all have viewed or after 14 days
  viewOnce          Boolean       @default(false)
  viewOnceExpiresAt DateTime?
  mediaDeletedAt    DateTime?
  views             MessageView[]
  isRead            Boolean       @default(false)
  readAt            DateTime?
  // { "❤️": ["userId", ...] }
  reactions         Json?
  createdAt         DateTime      @default(now())
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Event {
  id           String          @id @default(cuid())
  title        String
  description  String
  date         DateTime
  endDate      DateTime?
  location     String
  city         String?
  country      String?
  maxAttendees Int?
  imageUrl     String?
  category     EventCategory   @default(OTHER)
  isFeatured   Boolean         @default(false)
  isPrivate    Boolean         @default(false)
  createdBy    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  attendees    EventAttendee[]
}

model EventAttendee {
  id             String    @id @default(cuid())
  eventId        String
  userId         String
  status         String    @default("GOING")
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model ForumCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  icon        String?
  order       Int           @default(0)
  threads     ForumThread[]
}

model ForumThread {
  id         String        @id @default(cuid())
  categoryId String
  authorId   String
  title      String
  isPinned   Boolean       @default(false)
  isLocked   Boolean       @default(false)
  views      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts      ForumPost[]
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  authorId  String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Interest {
  id       String         @id @default(cuid())
  name     String         @unique
  category String?
  users    UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, type])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Share my date" safety plan — details are emailed to a trusted friend
model DatePlan {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchName     String
  matchUsername String?
  location      String
  dateTime      DateTime
  friendName    String
  friendEmail   String
  notes         String?
  checkedInAt   DateTime?
  createdAt     DateTime  @default(now())
}

// Daily Spark: one question per day (question list lives in code, keyed by id)
model SparkAnswer {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  answer     String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([questionId, createdAt])
}

// Profile view history (for "who viewed you" and the Platinum insights dashboard).
// Not written when the viewer is incognito.
model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("ViewsGiven", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId  String
  viewed    User     @relation("ViewsGot", fields: [viewedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([viewedId, createdAt])
  @@index([viewerId, viewedId, createdAt])
}

model PhotoLike {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([photoId, userId])
  @@index([photoId, createdAt])
  @@index([userId, createdAt])
}

// A member (requester) asks someone they met (reviewer) to review them.
model ReviewRequest {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("ReviewRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("ReviewRequestsGot", fields: [reviewerId], references: [id], onDelete: Cascade)
  // PENDING | COMPLETED | DECLINED | EXPIRED | CANCELLED
  status      String   @default("PENDING")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  review      Review?

  @@index([reviewerId, status])
  @@index([requesterId, status])
}

// Airbnb-style review: five 1–5 ratings plus a comment. Double-blind: hidden
// (publishedAt null) until both sides have reviewed each other or 14 days pass.
model Review {
  id            String         @id @default(cuid())
  reviewerId    String
  reviewer      User           @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId    String
  reviewee      User           @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  requestId     String?        @unique
  request       ReviewRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  respectful    Int
  communication Int
  authenticity  Int
  reliability   Int
  overall       Int
  comment       String
  // Reviewer marked the comment as containing explicit details (shown blurred until tapped)
  isExplicit    Boolean        @default(false)
  response      String?
  responseAt    DateTime?
  publishedAt   DateTime?
  // Moderation
  isHidden      Boolean        @default(false)
  hiddenReason  String?
  reportCount   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([reviewerId, revieweeId])
  @@index([revieweeId, publishedAt])
}

// One row per recipient who opened a view-once message.
model MessageView {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Short window during which the opened media may still be fetched (e.g. video playback ranges)
  openUntil DateTime
  viewedAt  DateTime @default(now())

  @@unique([messageId, userId])
}

// ───────────────────────── Store ─────────────────────────

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  products    Product[]
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  description    String
  // Prices in cents (ZAR), VAT-inclusive
  priceCents     Int
  compareAtCents Int?
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Media URLs (/api/media/<id>) in display order
  images         String[]         @default([])
  stock          Int              @default(0)
  sku            String?          @unique
  weightGrams    Int?
  tags           String[]         @default([])
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItems     OrderItem[]

  @@index([isActive, categoryId])
}

model Order {
  id                String      @id @default(cuid())
  // Human-friendly order number, e.g. TS-10023
  number            String      @unique
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  // PENDING_PAYMENT | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  status            String      @default("PENDING_PAYMENT")
  subtotalCents     Int
  shippingCents     Int
  totalCents        Int
  // Delivery
  recipientName     String
  phone             String
  email             String
  addressLine1      String
  addressLine2      String?
  suburb            String?
  city              String
  province          String
  postalCode        String
  deliveryNotes     String?
  discreetPackaging Boolean     @default(true)
  courier           String?
  trackingNumber    String?
  // Payment (PayFast once-off)
  paymentRef        String      @unique
  pfPaymentId       String?     @unique
  paidAt            DateTime?
  cancelledAt       DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  adminNotes        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot at time of purchase
  name       String
  priceCents Int
  quantity   Int
  image      String?
}

// Who changed admin roles (and other sensitive admin actions), for accountability.
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  // e.g. ADMIN_APPOINTED | ADMIN_REMOVED | USER_BANNED | USER_UNBANNED
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
}

// Paid membership lifecycle (one row per provider subscription; a member can
// have older EXPIRED rows). Members whose tier was set before this existed, or
// by an admin, have no row and are never touched by the lifecycle cron.
model Subscription {
  id                       String         @id @default(cuid())
  userId                   String
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PAYSTACK | PAYFAST | ADMIN
  provider                 String
  tier                     MembershipTier
  // monthly | annual
  period                   String
  // ACTIVE | CANCELLING | PAST_DUE | EXPIRED
  status                   String         @default("ACTIVE")
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean        @default(false)
  cancelledAt              DateTime?
  // Paystack: needed to disable/enable and to build the "update card" link
  providerSubscriptionCode String?        @unique
  providerCustomerCode     String?
  providerPlanCode         String?
  emailToken               String?
  // PayFast recurring billing token (ITN `token`)
  payfastToken             String?        @unique
  lastPaymentAt            DateTime?
  lastPaymentCents         Int?
  pastDueSince             DateTime?
  pastDueReminderAt        DateTime?
  // currentPeriodEnd the "renews/ends soon" reminder was sent for (once per period)
  renewalReminderFor       DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  payments                 Payment[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@index([providerCustomerCode])
}

// Every confirmed payment (membership or store), recorded once per provider reference.
model Payment {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PAYSTACK | PAYFAST
  provider       String
  // Paystack transaction reference, or "PF-<pf_payment_id>" for PayFast
  reference      String          @unique
  // MEMBERSHIP | STORE
  kind           String
  amountCents    Int
  currency       String          @default("ZAR")
  // SUCCESS | REFUNDED
  status         String          @default("SUCCESS")
  tier           MembershipTier?
  period         String?
  orderId        String?
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  raw            Json?
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
}
